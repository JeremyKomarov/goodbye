NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Public base URL, used for share links and OG images (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Cloudflare Turnstile bot check before anonymous sign-in. Set this AND
# turn on captcha (Turnstile + its secret key) in Supabase > Auth > Attack Protection.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# Optional: report errors to Sentry (server and browser). Without it nothing is sent.
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# Development only: serve DTO-parsed fixtures instead of calling the handlers. Refused in production.
# NEXT_PUBLIC_USE_MOCKS=true
